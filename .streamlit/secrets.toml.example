# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in the real values.
# On Streamlit Cloud, paste the contents in App settings > Secrets.

# --- Google OAuth (st.login) -------------------------------------------------
[auth]
redirect_uris       = ["https://<deine-app>.streamlit.app/oauth2callback", "http://localhost:8501/oauth2callback"]
cookie_secret       = "a-random-32-character-secret-string-here"
client_id           = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret       = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Comma-separated list of e-mail addresses that are allowed to access the app.
allowed_emails = [
    "admin@example.com",
    "kollege@example.com"
]

# --- GitHub API (for committing HTML / assets) --------------------------------
github_owner = "YOUR_GITHUB_USERNAME"
github_repo  = "Kompaniewebseite20"
github_token = "ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
github_branch = "main"

# --- AWS Bedrock (Claude) -----------------------------------------------------
# WICHTIG: Sonnet 4.5 erfordert ein Cross-Region Inference Profile (eu. Prefix).
# Modell in der AWS Console unter Bedrock > Model access aktivieren.
AWS_DEFAULT_REGION    = "eu-central-1"
AWS_ACCESS_KEY_ID     = "AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
BEDROCK_MODEL_ID      = "eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
